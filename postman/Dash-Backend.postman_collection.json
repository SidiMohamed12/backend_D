{
  "info": {
    "_postman_id": "c6b2a8a1-7d54-478e-b2a4-b2f03f7912be",
    "name": "Dash Backend API",
    "description": "Collection Postman pour tester tous les endpoints du backend Dash.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health - GET /api/v1/health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "description": "Vérifie que le backend est UP"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Health status is UP\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"UP\");",
              "});"
            ]
          }
        }
      ]
    },
